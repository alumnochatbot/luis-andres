<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Spider Fighter 3: Web Clash</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Bangers&family=Inter:wght@400;600;800&display=swap');
        .font-comic { font-family: 'Bangers', cursive, sans-serif; }
        body { font-family: 'Inter', sans-serif; background-color: #0b0f19; overflow: hidden; user-select: none; }
        canvas { display: block; touch-action: none; }
        .hud-shadow { text-shadow: 2px 2px 0px #000, -2px -2px 0px #000, 2px -2px 0px #000, -2px 2px 0px #000; }
        .health-bar-gradient { background: linear-gradient(90deg, #ef4444 0%, #f97316 100%); }
        .web-bar-gradient { background: linear-gradient(90deg, #38bdf8 0%, #818cf8 100%); }
    </style>
</head>
<body class="w-screen h-screen flex flex-col items-center justify-center relative">

    <div id="game-container" class="relative w-full h-full max-w-6xl max-h-[900px] shadow-2xl overflow-hidden rounded-2xl border-4 border-slate-700 bg-slate-900 flex flex-col">
        
        <!-- Canvas Layer -->
        <canvas id="gameCanvas" class="w-full h-full absolute inset-0 z-0"></canvas>

        <div id="hud" class="absolute inset-0 z-10 pointer-events-none p-4 flex flex-col justify-between hidden">
            <!-- Top Bar -->
            <div class="flex justify-between items-start">
                <div class="flex flex-col gap-2 w-1/3">
                    <!-- Health -->
                    <div class="flex items-center gap-2">
                        <span class="text-red-500 font-comic text-xl hud-shadow">HP</span>
                        <div class="w-full bg-slate-800/80 rounded-full h-4 border-2 border-red-600 overflow-hidden shadow-lg">
                            <div id="health-bar" class="health-bar-gradient h-full transition-all duration-200" style="width: 100%;"></div>
                        </div>
                    </div>
                    <!-- Web Fluid -->
                    <div class="flex items-center gap-2">
                        <span class="text-sky-400 font-comic text-xl hud-shadow">WEB</span>
                        <div class="w-full bg-slate-800/80 rounded-full h-3 border-2 border-sky-500 overflow-hidden shadow-lg">
                            <div id="web-bar" class="web-bar-gradient h-full transition-all duration-100" style="width: 100%;"></div>
                        </div>
                    </div>
                </div>

                <!-- Scores & Wave -->
                <div class="text-center">
                    <div id="wave-display" class="font-comic text-3xl text-yellow-400 hud-shadow tracking-wider">WAVE 1</div>
                    <div id="score-display" class="font-comic text-xl text-white hud-shadow">SCORE: 0</div>
                </div>

                <!-- Controls & Pause Button -->
                <div class="flex gap-3 pointer-events-auto">
                    <button id="pause-btn" class="bg-slate-800/90 hover:bg-slate-700 text-white p-3 rounded-xl border-2 border-slate-600 shadow-xl transition active:scale-95">
                        <i class="fa-solid fa-pause text-xl"></i>
                    </button>
                </div>
            </div>

            <!-- Combo Counter & Floating Notifications -->
            <div class="flex justify-between items-end pb-4">
                <div id="combo-container" class="opacity-0 transition-all duration-300 transform scale-75">
                    <div class="font-comic text-4xl text-amber-300 hud-shadow animate-bounce" id="combo-text">5x COMBO!</div>
                </div>
                <div id="mission-objective" class="bg-black/60 backdrop-blur-md px-4 py-2 rounded-xl border border-sky-500/50 text-sky-300 text-sm font-semibold">
                    Eliminate all hostile thugs!
                </div>
            </div>
        </div>

        <!-- Main Menu -->
        <div id="screen-main" class="absolute inset-0 z-20 bg-gradient-to-br from-slate-950 via-indigo-950 to-slate-900 flex flex-col items-center justify-center p-6 text-center">
            <div class="absolute inset-0 opacity-20 bg-[radial-gradient(#38bdf8_1px,transparent_1px)] [background-size:24px_24px]"></div>
            <div class="relative z-10 max-w-xl mx-auto flex flex-col items-center">
                <div class="inline-block bg-red-600 text-white font-comic text-sm tracking-widest px-4 py-1 rounded-full mb-3 shadow-lg uppercase">Marvelous Action Game</div>
                <h1 class="font-comic text-6xl md:text-8xl text-white hud-shadow tracking-wide mb-2 bg-gradient-to-r from-red-500 via-rose-400 to-sky-400 bg-clip-text text-transparent">SPIDER FIGHTER 3</h1>
                <p class="text-slate-300 text-base md:text-lg mb-8 max-w-md">Swing through the neon skyline, unleash epic web combos, and protect the city from mutant syndicates!</p>
                
                <div class="flex flex-col sm:flex-row gap-4 w-full max-w-sm">
                    <button id="start-btn" class="flex-1 bg-gradient-to-r from-red-600 to-rose-700 hover:from-red-500 hover:to-rose-600 text-white font-comic text-2xl py-4 px-8 rounded-2xl shadow-xl border-2 border-red-400 transition transform hover:-translate-y-1 active:translate-y-0">
                        <i class="fa-solid fa-play mr-2"></i> START GAME
                    </button>
                    <button id="upgrades-btn" class="flex-1 bg-gradient-to-r from-sky-600 to-indigo-700 hover:from-sky-500 hover:to-indigo-600 text-white font-comic text-2xl py-4 px-8 rounded-2xl shadow-xl border-2 border-sky-400 transition transform hover:-translate-y-1 active:translate-y-0">
                        <i class="fa-solid fa-bolt mr-2"></i> UPGRADES
                    </button>
                </div>
                <div class="mt-8 text-xs text-slate-400 flex gap-4">
                    <span><kbd class="bg-slate-800 px-2 py-1 rounded border border-slate-700 text-slate-200">A/D</kbd> Move</span>
                    <span><kbd class="bg-slate-800 px-2 py-1 rounded border border-slate-700 text-slate-200">Space</kbd> Jump/Swing</span>
                    <span><kbd class="bg-slate-800 px-2 py-1 rounded border border-slate-700 text-slate-200">J</kbd> Punch</span>
                    <span><kbd class="bg-slate-800 px-2 py-1 rounded border border-slate-700 text-slate-200">K</kbd> Web Shoot</span>
                </div>
            </div>
        </div>

        <!-- Upgrades Screen -->
        <div id="screen-upgrades" class="absolute inset-0 z-20 bg-slate-950/95 backdrop-blur-xl flex flex-col items-center justify-center p-6 hidden">
            <div class="max-w-xl w-full bg-slate-900 border border-slate-700 rounded-3xl p-6 shadow-2xl flex flex-col gap-6">
                <div class="flex justify-between items-center border-b border-slate-800 pb-4">
                    <h2 class="font-comic text-3xl text-yellow-400 hud-shadow">HERO UPGRADES</h2>
                    <div class="bg-slate-800 px-4 py-2 rounded-xl text-yellow-400 font-bold border border-yellow-500/30">
                        Coins: <span id="coins-display">0</span>
                    </div>
                </div>

                <div class="flex flex-col gap-4">
                    <div class="bg-slate-800/60 p-4 rounded-2xl border border-slate-700 flex justify-between items-center">
                        <div>
                            <h4 class="font-bold text-white text-lg">Spider Strength</h4>
                            <p class="text-xs text-slate-400">Increase melee punch damage (+10)</p>
                        </div>
                        <button id="upgrade-strength" class="bg-yellow-500 hover:bg-yellow-400 text-slate-950 font-bold px-4 py-2 rounded-xl text-sm transition">
                            Buy (Cost: <span id="cost-strength">100</span>)
                        </button>
                    </div>
                    <div class="bg-slate-800/60 p-4 rounded-2xl border border-slate-700 flex justify-between items-center">
                        <div>
                            <h4 class="font-bold text-white text-lg">Web Capacity</h4>
                            <p class="text-xs text-slate-400">Increase max web fluid and recovery rate</p>
                        </div>
                        <button id="upgrade-web" class="bg-yellow-500 hover:bg-yellow-400 text-slate-950 font-bold px-4 py-2 rounded-xl text-sm transition">
                            Buy (Cost: <span id="cost-web">150</span>)
                        </button>
                    </div>
                    <div class="bg-slate-800/60 p-4 rounded-2xl border border-slate-700 flex justify-between items-center">
                        <div>
                            <h4 class="font-bold text-white text-lg">Armor Plating</h4>
                            <p class="text-xs text-slate-400">Increase maximum health points (+25)</p>
                        </div>
                        <button id="upgrade-armor" class="bg-yellow-500 hover:bg-yellow-400 text-slate-950 font-bold px-4 py-2 rounded-xl text-sm transition">
                            Buy (Cost: <span id="cost-armor">200</span>)
                        </button>
                    </div>
                </div>

                <button id="close-upgrades" class="bg-slate-800 hover:bg-slate-700 text-white font-comic text-xl py-3 rounded-2xl border border-slate-600 transition">
                    BACK TO MENU
                </button>
            </div>
        </div>

        <!-- Pause Screen -->
        <div id="screen-pause" class="absolute inset-0 z-20 bg-black/80 backdrop-blur-md flex flex-col items-center justify-center p-6 hidden">
            <div class="bg-slate-900 border border-slate-700 rounded-3xl p-8 max-w-sm w-full text-center flex flex-col gap-4 shadow-2xl">
                <h2 class="font-comic text-4xl text-white hud-shadow mb-2">GAME PAUSED</h2>
                <button id="resume-btn" class="bg-sky-600 hover:bg-sky-500 text-white font-comic text-xl py-3 rounded-2xl transition">RESUME</button>
                <button id="restart-btn" class="bg-amber-600 hover:bg-amber-500 text-white font-comic text-xl py-3 rounded-2xl transition">RESTART</button>
                <button id="quit-btn" class="bg-slate-800 hover:bg-slate-700 text-white font-comic text-xl py-3 rounded-2xl transition">QUIT TO MENU</button>
            </div>
        </div>

        <!-- Game Over Screen -->
        <div id="screen-gameover" class="absolute inset-0 z-20 bg-red-950/90 backdrop-blur-md flex flex-col items-center justify-center p-6 hidden text-center">
            <div class="max-w-md w-full bg-slate-900/90 border-2 border-red-600 rounded-3xl p-8 shadow-2xl flex flex-col gap-6">
                <h2 class="font-comic text-6xl text-red-500 hud-shadow animate-pulse">DEFEATED</h2>
                <div class="flex flex-col gap-2">
                    <p class="text-slate-300 text-sm">You fought bravely, but the city was overwhelmed.</p>
                    <div class="text-2xl font-comic text-yellow-400" id="final-score">FINAL SCORE: 0</div>
                </div>
                <div class="flex flex-col gap-3">
                    <button id="retry-btn" class="bg-red-600 hover:bg-red-500 text-white font-comic text-2xl py-3 rounded-2xl shadow-lg transition">TRY AGAIN</button>
                    <button id="menu-btn" class="bg-slate-800 hover:bg-slate-700 text-white font-comic text-xl py-3 rounded-2xl transition">MAIN MENU</button>
                </div>
            </div>
        </div>

        <div id="touch-controls" class="absolute inset-0 z-10 pointer-events-none p-6 flex justify-between items-end pb-8 md:hidden hidden">
            <!-- Left Controls: Move & Swing -->
            <div class="flex gap-3 pointer-events-auto">
                <button id="btn-left" class="w-16 h-16 bg-slate-800/80 active:bg-slate-600 text-white rounded-2xl border-2 border-slate-600 flex items-center justify-center text-2xl shadow-lg">
                    <i class="fa-solid fa-arrow-left"></i>
                </button>
                <button id="btn-right" class="w-16 h-16 bg-slate-800/80 active:bg-slate-600 text-white rounded-2xl border-2 border-slate-600 flex items-center justify-center text-2xl shadow-lg">
                    <i class="fa-solid fa-arrow-right"></i>
                </button>
                <button id="btn-swing" class="w-16 h-16 bg-sky-600/80 active:bg-sky-500 text-white rounded-2xl border-2 border-sky-400 flex items-center justify-center text-2xl shadow-lg">
                    <i class="fa-solid fa-spider"></i>
                </button>
            </div>
            <!-- Right Controls: Punch & Web -->
            <div class="flex gap-3 pointer-events-auto">
                <button id="btn-web" class="w-16 h-16 bg-indigo-600/80 active:bg-indigo-500 text-white rounded-2xl border-2 border-indigo-400 flex items-center justify-center text-2xl shadow-lg">
                    <i class="fa-solid fa-bullseye"></i>
                </button>
                <button id="btn-punch" class="w-16 h-16 bg-red-600/80 active:bg-red-500 text-white rounded-2xl border-2 border-red-400 flex items-center justify-center text-2xl shadow-lg">
                    <i class="fa-solid fa-hand-fist"></i>
                </button>
            </div>
        </div>
    </div>

    <script>
        // Audio Synthesizer using Web Audio API
        class SoundEngine {
            constructor() {
                this.ctx = null;
            }
            init() {
                if (!this.ctx) {
                    this.ctx = new (window.AudioContext || window.webkitAudioContext)();
                }
            }
            playPunch() {
                if (!this.ctx) return;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(150, this.ctx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(30, this.ctx.currentTime + 0.15);
                gain.gain.setValueAtTime(0.5, this.ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.15);
                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start();
                osc.stop(this.ctx.currentTime + 0.15);
            }
            playWeb() {
                if (!this.ctx) return;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(600, this.ctx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(200, this.ctx.currentTime + 0.2);
                gain.gain.setValueAtTime(0.3, this.ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.2);
                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start();
                osc.stop(this.ctx.currentTime + 0.2);
            }
            playExplosion() {
                if (!this.ctx) return;
                const bufferSize = this.ctx.sampleRate * 0.3;
                const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
                const data = buffer.getChannelData(0);
                for (let i = 0; i < bufferSize; i++) {
                    data[i] = Math.random() * 2 - 1;
                }
                const noise = this.ctx.createBufferSource();
                noise.buffer = buffer;
                const filter = this.ctx.createBiquadFilter();
                filter.type = 'lowpass';
                filter.frequency.setValueAtTime(800, this.ctx.currentTime);
                filter.frequency.linearRampToValueAtTime(50, this.ctx.currentTime + 0.3);
                const gain = this.ctx.createGain();
                gain.gain.setValueAtTime(0.6, this.ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.3);
                noise.connect(filter);
                filter.connect(gain);
                gain.connect(this.ctx.destination);
                noise.start();
            }
        }

        const sound = new SoundEngine();

        // Game State Variables
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');

        let gameState = 'MENU'; // MENU, UPGRADES, PLAYING, PAUSED, GAMEOVER
        let score = 0;
        let wave = 1;
        let coins = parseInt(localStorage.getItem('sf3_coins') || '0');
        let upgrades = JSON.parse(localStorage.getItem('sf3_upgrades') || JSON.stringify({ strength: 0, web: 0, armor: 0 }));

        let player = {
            x: 100,
            y: 300,
            vx: 0,
            vy: 0,
            width: 40,
            height: 70,
            speed: 5,
            jumpForce: -12,
            gravity: 0.6,
            grounded: false,
            health: 100,
            maxHealth: 100,
            webFluid: 100,
            maxWeb: 100,
            facing: 1, // 1: right, -1: left
            isSwinging: false,
            swingPoint: null,
            swingAngle: 0,
            swingLength: 0,
            combo: 0,
            comboTimer: 0,
            invulnerable: 0
        };

        let keys = {};
        let enemies = [];
        let projectiles = [];
        let particles = [];
        let buildings = [];
        let spawnTimer = 0;

        // Resize Canvas
        function resizeCanvas() {
            canvas.width = canvas.parentElement.clientWidth;
            canvas.height = canvas.parentElement.clientHeight;
            if (buildings.length === 0) initCity();
        }
        window.addEventListener('resize', resizeCanvas);

        // Procedural City Background
        function initCity() {
            buildings = [];
            let currentX = 0;
            while (currentX < canvas.width * 2) {
                let w = 120 + Math.random() * 100;
                let h = 250 + Math.random() * 300;
                let windows = [];
                for (let wx = 15; wx < w - 15; wx += 25) {
                    for (let wy = 30; wy < h - 30; wy += 35) {
                        windows.push({ x: wx, y: wy, lit: Math.random() > 0.4 });
                    }
                }
                buildings.push({ x: currentX, y: canvas.height - h, width: w, height: h, windows });
                currentX += w + 20;
            }
        }

        // Initialize Player stats based on upgrades
        function resetPlayerStats() {
            player.maxHealth = 100 + (upgrades.armor * 25);
            player.health = player.maxHealth;
            player.maxWeb = 100 + (upgrades.web * 30);
            player.webFluid = player.maxWeb;
            player.x = 100;
            player.y = canvas.height - 200;
            player.vx = 0;
            player.vy = 0;
            player.isSwinging = false;
        }

        // Start Game
        function startGame() {
            sound.init();
            resetPlayerStats();
            score = 0;
            wave = 1;
            enemies = [];
            projectiles = [];
            particles = [];
            spawnWave();
            document.getElementById('screen-main').classList.add('hidden');
            document.getElementById('screen-pause').classList.add('hidden');
            document.getElementById('screen-gameover').classList.add('hidden');
            document.getElementById('hud').classList.remove('hidden');
            if ('ontouchstart' in window || navigator.maxTouchPoints > 0) {
                document.getElementById('touch-controls').classList.remove('hidden');
            }
            gameState = 'PLAYING';
        }

        // Spawn Enemy Wave
        function spawnWave() {
            let count = 3 + wave * 2;
            for (let i = 0; i < count; i++) {
                enemies.push({
                    x: canvas.width + 100 + Math.random() * 600,
                    y: canvas.height - 120,
                    width: 45,
                    height: 65,
                    vx: 0,
                    vy: 0,
                    health: 40 + wave * 10,
                    maxHealth: 40 + wave * 10,
                    type: Math.random() > 0.7 ? 'brute' : 'thug',
                    attackCooldown: 0,
                    stunned: 0,
                    facing: -1
                });
            }
            document.getElementById('wave-display').innerText = `WAVE ${wave}`;
        }

        // Input Listeners
        window.addEventListener('keydown', e => {
            keys[e.code] = true;
            if (e.code === 'KeyJ' && gameState === 'PLAYING') playerAttack();
            if (e.code === 'KeyK' && gameState === 'PLAYING') playerShootWeb();
            if (e.code === 'Space' && gameState === 'PLAYING') {
                e.preventDefault();
                toggleSwing();
            }
            if (e.code === 'Escape') togglePause();
        });

        window.addEventListener('keyup', e => {
            keys[e.code] = false;
        });

        // Touch Control Button Bindings
        function setupTouchButton(id, action) {
            const el = document.getElementById(id);
            if (!el) return;
            el.addEventListener('touchstart', e => { e.preventDefault(); action(true); });
            el.addEventListener('touchend', e => { e.preventDefault(); action(false); });
        }

        setupTouchButton('btn-left', active => keys['KeyA'] = active);
        setupTouchButton('btn-right', active => keys['KeyD'] = active);
        document.getElementById('btn-swing').addEventListener('click', () => { if (gameState === 'PLAYING') toggleSwing(); });
        document.getElementById('btn-punch').addEventListener('click', () => { if (gameState === 'PLAYING') playerAttack(); });
        document.getElementById('btn-web').addEventListener('click', () => { if (gameState === 'PLAYING') playerShootWeb(); });

        // Player Actions
        function playerAttack() {
            if (player.isSwinging) return;
            sound.playPunch();
            // Check enemy hits in front
            let hitBox = {
                x: player.facing === 1 ? player.x + player.width : player.x - 50,
                y: player.y,
                width: 50,
                height: player.height
            };

            let hitAny = false;
            enemies.forEach(en => {
                if (en.x < hitBox.x + hitBox.width && en.x + en.width > hitBox.x && en.y < hitBox.y + hitBox.height && en.y + en.height > hitBox.y) {
                    let dmg = 25 + (upgrades.strength * 10);
                    en.health -= dmg;
                    en.vx = player.facing * 8;
                    en.vy = -4;
                    en.stunned = 30;
                    hitAny = true;
                    addParticles(en.x + en.width/2, en.y + en.height/2, '#ef4444', 8);
                }
            });

            if (hitAny) {
                player.combo++;
                player.comboTimer = 120;
                updateComboDisplay();
            }
        }

        function playerShootWeb() {
            if (player.webFluid < 15 || player.isSwinging) return;
            player.webFluid -= 15;
            sound.playWeb();
            projectiles.push({
                x: player.x + (player.facing === 1 ? player.width : 0),
                y: player.y + player.height / 2,
                vx: player.facing * 14,
                vy: 0,
                radius: 8
            });
        }

        function toggleSwing() {
            if (player.isSwinging) {
                player.isSwinging = false;
                player.vx = Math.cos(player.swingAngle) * 12;
                player.vy = Math.sin(player.swingAngle) * 12;
            } else {
                if (player.webFluid < 20) return;
                player.webFluid -= 20;
                sound.playWeb();
                // Find anchor point above player
                player.swingPoint = { x: player.x + player.facing * 100, y: player.y - 180 };
                let dx = player.x - player.swingPoint.x;
                let dy = player.y - player.swingPoint.y;
                player.swingLength = Math.sqrt(dx*dx + dy*dy);
                player.swingAngle = Math.atan2(dy, dx);
                player.isSwinging = true;
            }
        }

        function updateComboDisplay() {
            const container = document.getElementById('combo-container');
            const text = document.getElementById('combo-text');
            if (player.combo > 1) {
                text.innerText = `${player.combo}x COMBO!`;
                container.classList.remove('opacity-0', 'scale-75');
            } else {
                container.classList.add('opacity-0', 'scale-75');
            }
        }

        function addParticles(x, y, color, count) {
            for (let i = 0; i < count; i++) {
                particles.push({
                    x, y,
                    vx: (Math.random() - 0.5) * 8,
                    vy: (Math.random() - 0.5) * 8,
                    life: 30 + Math.random() * 20,
                    color,
                    size: 3 + Math.random() * 4
                });
            }
        }

        // Main Game Update Loop
        function update() {
            if (gameState !== 'PLAYING') return;

            // Combo timer decay
            if (player.comboTimer > 0) {
                player.comboTimer--;
                if (player.comboTimer === 0) {
                    player.combo = 0;
                    updateComboDisplay();
                }
            }

            // Web fluid regeneration
            if (player.webFluid < player.maxWeb) {
                player.webFluid += 0.15;
            }

            // Invulnerability timer
            if (player.invulnerable > 0) player.invulnerable--;

            // Player Movement / Physics
            if (player.isSwinging) {
                // Pendulum physics
                let gravityAcc = 0.3;
                player.swingAngle += 0.04 * (player.x > player.swingPoint.x ? 1 : -1);
                player.x = player.swingPoint.x + Math.cos(player.swingAngle) * player.swingLength;
                player.y = player.swingPoint.y + Math.sin(player.swingAngle) * player.swingLength;
            } else {
                if (keys['KeyA'] || keys['ArrowLeft']) {
                    player.vx = -player.speed;
                    player.facing = -1;
                } else if (keys['KeyD'] || keys['ArrowRight']) {
                    player.vx = player.speed;
                    player.facing = 1;
                } else {
                    player.vx *= 0.8;
                }

                if ((keys['KeyW'] || keys['ArrowUp']) && player.grounded) {
                    player.vy = player.jumpForce;
                    player.grounded = false;
                }

                player.vy += player.gravity;
                player.x += player.vx;
                player.y += player.vy;

                let groundLevel = canvas.height - 80;
                if (player.y + player.height >= groundLevel) {
                    player.y = groundLevel - player.height;
                    player.vy = 0;
                    player.grounded = true;
                }
            }

            // Boundaries
            if (player.x < 0) player.x = 0;
            if (player.x > canvas.width - player.width) player.x = canvas.width - player.width;

            // Update Projectiles
            for (let i = projectiles.length - 1; i >= 0; i--) {
                let p = projectiles[i];
                p.x += p.vx;
                // Check enemy collision
                let hit = false;
                for (let en of enemies) {
                    if (p.x > en.x && p.x < en.x + en.width && p.y > en.y && p.y < en.y + en.height) {
                        en.stunned = 90;
                        en.health -= 15;
                        hit = true;
                        addParticles(en.x + en.width/2, en.y + en.height/2, '#38bdf8', 6);
                        break;
                    }
                }
                if (hit || p.x < 0 || p.x > canvas.width) {
                    projectiles.splice(i, 1);
                }
            }

            // Update Enemies
            for (let i = enemies.length - 1; i >= 0; i--) {
                let en = enemies[i];
                if (en.health <= 0) {
                    addParticles(en.x + en.width/2, en.y + en.height/2, '#f59e0b', 15);
                    sound.playExplosion();
                    enemies.splice(i, 1);
                    score += 100 * wave;
                    coins += 10;
                    localStorage.setItem('sf3_coins', coins);
                    continue;
                }

                if (en.stunned > 0) {
                    en.stunned--;
                    continue;
                }

                // AI Chase Player
                let dx = player.x - en.x;
                if (Math.abs(dx) > 10) {
                    en.facing = dx > 0 ? 1 : -1;
                    en.vx = en.facing * (en.type === 'brute' ? 2 : 3);
                } else {
                    en.vx = 0;
                    if (en.attackCooldown <= 0 && player.invulnerable === 0) {
                        // Enemy Attack
                        if (Math.abs(player.x - en.x) < 60) {
                            player.health -= en.type === 'brute' ? 25 : 15;
                            player.invulnerable = 45;
                            addParticles(player.x + player.width/2, player.y + player.height/2, '#ef4444', 10);
                            sound.playPunch();
                            en.attackCooldown = 60;
                        }
                    }
                }

                if (en.attackCooldown > 0) en.attackCooldown--;

                en.vy += 0.6;
                en.x += en.vx;
                en.y += en.vy;

                let groundLevel = canvas.height - 80;
                if (en.y + en.height >= groundLevel) {
                    en.y = groundLevel - en.height;
                    en.vy = 0;
                }
            }

            // Check Wave Completion
            if (enemies.length === 0) {
                wave++;
                score += 500;
                spawnWave();
            }

            // Update Particles
            for (let i = particles.length - 1; i >= 0; i--) {
                let pt = particles[i];
                pt.x += pt.vx;
                pt.y += pt.vy;
                pt.life--;
                if (pt.life <= 0) particles.splice(i, 1);
            }

            // Check Game Over
            if (player.health <= 0) {
                gameState = 'GAMEOVER';
                document.getElementById('hud').classList.add('hidden');
                document.getElementById('touch-controls').classList.add('hidden');
                document.getElementById('screen-gameover').classList.remove('hidden');
                document.getElementById('final-score').innerText = `FINAL SCORE: ${score}`;
            }

            // Update HUD elements
            document.getElementById('health-bar').style.width = `${Math.max(0, (player.health / player.maxHealth) * 100)}%`;
            document.getElementById('web-bar').style.width = `${Math.max(0, (player.webFluid / player.maxWeb) * 100)}%`;
            document.getElementById('score-display').innerText = `SCORE: ${score}`;
        }

        // Render Graphics Loop
        function draw() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            // Draw Sky Gradient
            let skyGrad = ctx.createLinearGradient(0, 0, 0, canvas.height);
            skyGrad.addColorStop(0, '#090d16');
            skyGrad.addColorStop(0.5, '#1e1b4b');
            skyGrad.addColorStop(1, '#31103f');
            ctx.fillStyle = skyGrad;
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            // Draw Buildings (Parallax Background)
            buildings.forEach(b => {
                ctx.fillStyle = '#0f172a';
                ctx.fillRect(b.x, b.y, b.width, b.height);
                b.windows.forEach(w => {
                    ctx.fillStyle = w.lit ? '#fde047' : '#1e293b';
                    ctx.fillRect(b.x + w.x, b.y + w.y, 10, 16);
                });
            });

            // Draw Ground Street
            let groundY = canvas.height - 80;
            ctx.fillStyle = '#1e293b';
            ctx.fillRect(0, groundY, canvas.width, 80);
            ctx.fillStyle = '#334155';
            ctx.fillRect(0, groundY, canvas.width, 8);
            // Road markings
            ctx.fillStyle = '#facc15';
            for (let rx = 0; rx < canvas.width; rx += 80) {
                ctx.fillRect(rx, groundY + 35, 40, 6);
            }

            // Draw Swing Web Line
            if (player.isSwinging && player.swingPoint) {
                ctx.strokeStyle = 'rgba(255, 255, 255, 0.8)';
                ctx.lineWidth = 2;
                ctx.beginPath();
                ctx.moveTo(player.swingPoint.x, player.swingPoint.y);
                ctx.lineTo(player.x + player.width/2, player.y + 20);
                ctx.stroke();
            }

            // Draw Projectiles
            ctx.fillStyle = '#38bdf8';
            projectiles.forEach(p => {
                ctx.beginPath();
                ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
                ctx.fill();
            });

            // Draw Enemies
            enemies.forEach(en => {
                ctx.fillStyle = en.type === 'brute' ? '#dc2626' : '#7c3aed';
                ctx.fillRect(en.x, en.y, en.width, en.height);
                // Enemy Eyes / Details
                ctx.fillStyle = '#f8fafc';
                let eyeX = en.facing === 1 ? en.x + en.width - 12 : en.x + 4;
                ctx.fillRect(eyeX, en.y + 12, 8, 6);

                // Health bar above enemy
                ctx.fillStyle = '#334155';
                ctx.fillRect(en.x, en.y - 12, en.width, 6);
                ctx.fillStyle = '#22c55e';
                ctx.fillRect(en.x, en.y - 12, en.width * (en.health / en.maxHealth), 6);
            });

            // Draw Player (Spider-Man style costume)
            ctx.save();
            if (player.invulnerable % 4 < 2) {
                // Red Suit Body
                ctx.fillStyle = '#dc2626';
                ctx.fillRect(player.x, player.y + 15, player.width, player.height - 25);
                
                // Blue Sides / Legs
                ctx.fillStyle = '#2563eb';
                ctx.fillRect(player.x, player.y + 45, player.width, player.height - 45);

                // Mask / Head
                ctx.fillStyle = '#dc2626';
                ctx.beginPath();
                ctx.arc(player.x + player.width/2, player.y + 15, 16, 0, Math.PI * 2);
                ctx.fill();

                // Big White Eyes
                ctx.fillStyle = '#f8fafc';
                let eyeDir = player.facing;
                ctx.beginPath();
                ctx.ellipse(player.x + player.width/2 + eyeDir * 4, player.y + 13, 6, 3, eyeDir * 0.2, 0, Math.PI * 2);
                ctx.fill();
            }
            ctx.restore();

            // Draw Particles
            particles.forEach(pt => {
                ctx.fillStyle = pt.color;
                ctx.beginPath();
                ctx.arc(pt.x, pt.y, pt.size, 0, Math.PI * 2);
                ctx.fill();
            });
        }

        function gameLoop() {
            update();
            draw();
            requestAnimationFrame(gameLoop);
        }

        // UI Event Handlers
        document.getElementById('start-btn').addEventListener('click', startGame);
        document.getElementById('retry-btn').addEventListener('click', startGame);
        
        document.getElementById('upgrades-btn').addEventListener('click', () => {
            updateUpgradesUI();
            document.getElementById('screen-main').classList.add('hidden');
            document.getElementById('screen-upgrades').classList.remove('hidden');
        });

        document.getElementById('close-upgrades').addEventListener('click', () => {
            document.getElementById('screen-upgrades').classList.add('hidden');
            document.getElementById('screen-main').classList.remove('hidden');
        });

        document.getElementById('pause-btn').addEventListener('click', togglePause);
        document.getElementById('resume-btn').addEventListener('click', togglePause);
        document.getElementById('restart-btn').addEventListener('click', () => {
            document.getElementById('screen-pause').classList.add('hidden');
            startGame();
        });
        document.getElementById('quit-btn').addEventListener('click', () => {
            document.getElementById('screen-pause').classList.add('hidden');
            document.getElementById('hud').classList.add('hidden');
            document.getElementById('touch-controls').classList.add('hidden');
            document.getElementById('screen-main').classList.remove('hidden');
            gameState = 'MENU';
        });
        document.getElementById('menu-btn').addEventListener('click', () => {
            document.getElementById('screen-gameover').classList.add('hidden');
            document.getElementById('screen-main').classList.remove('hidden');
            gameState = 'MENU';
        });

        function togglePause() {
            if (gameState === 'PLAYING') {
                gameState = 'PAUSED';
                document.getElementById('screen-pause').classList.remove('hidden');
            } else if (gameState === 'PAUSED') {
                gameState = 'PLAYING';
                document.getElementById('screen-pause').classList.add('hidden');
            }
        }

        function updateUpgradesUI() {
            document.getElementById('coins-display').innerText = coins;
            document.getElementById('cost-strength').innerText = (upgrades.strength + 1) * 100;
            document.getElementById('cost-web').innerText = (upgrades.web + 1) * 150;
            document.getElementById('cost-armor').innerText = (upgrades.armor + 1) * 200;
        }

        document.getElementById('upgrade-strength').addEventListener('click', () => {
            let cost = (upgrades.strength + 1) * 100;
            if (coins >= cost) {
                coins -= cost;
                upgrades.strength++;
                localStorage.setItem('sf3_coins', coins);
                localStorage.setItem('sf3_upgrades', JSON.stringify(upgrades));
                updateUpgradesUI();
            }
        });

        document.getElementById('upgrade-web').addEventListener('click', () => {
            let cost = (upgrades.web + 1) * 150;
            if (coins >= cost) {
                coins -= cost;
                upgrades.web++;
                localStorage.setItem('sf3_coins', coins);
                localStorage.setItem('sf3_upgrades', JSON.stringify(upgrades));
                updateUpgradesUI();
            }
        });

        document.getElementById('upgrade-armor').addEventListener('click', () => {
            let cost = (upgrades.armor + 1) * 200;
            if (coins >= cost) {
                coins -= cost;
                upgrades.armor++;
                localStorage.setItem('sf3_coins', coins);
                localStorage.setItem('sf3_upgrades', JSON.stringify(upgrades));
                updateUpgradesUI();
            }
        });

        // Initialize Canvas & Start Loop
        resizeCanvas();
        requestAnimationFrame(gameLoop);
    </script>
</body>
</html>
